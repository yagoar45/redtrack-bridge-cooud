# Segredo do endpoint de webhook, prefixo whsec_.
# Cooud: Store -> Integrações -> Webhooks (exibido uma única vez).
COOUD_WEBHOOK_SECRET=whsec_

# Postback da offer source Cooud no RedTrack.
RTK_POSTBACK_URL=https://jisrr.ttrk.io/postback

# Token da proteção de duplicata. Deixe preenchido e mantenha a proteção
# LIGADA no RedTrack — é a segunda camada de dedupe, caso o bridge reinicie.
RTK_PTOKEN=

# Campo do pedido usado como receita. net_amount = após taxas da plataforma.
# Alternativas: amount, total_amount. Ver README.
AMOUNT_FIELD=net_amount

# Cache da cotação. Cotação só é consultada quando o cache expira.
FX_TTL_HOURS=6

# Usados apenas se a API de câmbio estiver fora. Nunca repassam valor cru.
FX_FALLBACK_USDBRL=5.40
FX_FALLBACK_EURUSD=1.08

PORT=3000
